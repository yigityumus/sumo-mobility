# Leave blank during local development because Vite proxies /api to FastAPI.
VITE_API_BASE_URL=

# Default map view. These values point near Cité Scientifique and can be changed.
VITE_DEFAULT_LAT=50.6110
VITE_DEFAULT_LNG=3.1420
VITE_DEFAULT_ZOOM=15

# server = FastAPI-backed model persistence; local = browser IndexedDB fallback.
VITE_MODEL_STORAGE=server
