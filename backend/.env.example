ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OVERPASS_ENDPOINTS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter
OSM_USER_AGENT=sumo-area-builder/0.2 (contact: replace-with-your-email@example.com)
OSM_MAP_API_ENDPOINT=https://api.openstreetmap.org/api/0.6/map
OSM_MAP_MAX_BBOX_AREA_DEGREES=0.01
OVERPASS_TIMEOUT_SECONDS=90
OVERPASS_ENDPOINT_BUDGET_SECONDS=45
CACHE_TTL_SECONDS=600
MAX_BOUNDARY_VERTICES=500
MAX_BOUNDARY_SPAN_DEGREES=0.25

# Ephemeral workspace only. PostgreSQL and object storage are authoritative.
MODEL_STORAGE_DIR=/tmp/campus-simulation/models

# Docker Compose supplies these automatically. For local development against
# MinIO running on localhost, uncomment and set matching credentials.
# OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
# OBJECT_STORAGE_ACCESS_KEY=campus_app
# OBJECT_STORAGE_SECRET_KEY=campus_minio_dev_password
OBJECT_STORAGE_BUCKET=campus-simulation
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_PREFIX=models
REFERENCE_DATA_BUCKET=campus-reference-data
REFERENCE_DATA_PREFIX=raw
MAX_REFERENCE_UPLOAD_MB=100

# Docker Compose supplies DATABASE_URL automatically. For local development,
# uncomment this after starting a PostgreSQL instance on localhost.
# DATABASE_URL=postgresql://campus_app:campus_dev_password@127.0.0.1:5432/campus_simulation
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Docker Compose supplies this URL automatically. For a fully separated local
# stack, set it and run both worker commands shown in the README.
# RABBITMQ_URL=amqp://campus_app:campus_dev_password@127.0.0.1:5672/%2F
SIMULATION_QUEUE_NAME=simulation.jobs
SIMULATION_WORKER_CONCURRENCY=2
ANALYTICS_QUEUE_NAME=analytics.jobs
