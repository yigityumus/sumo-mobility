# Docker Compose settings. Copy this file to .env before a server deployment.
APP_PORT=8000
POSTGRES_DB=campus_simulation
POSTGRES_USER=campus_app
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
RABBITMQ_USER=campus_app
RABBITMQ_PASSWORD=replace-with-a-second-random-alphanumeric-password
MINIO_ROOT_USER=campus_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-third-random-alphanumeric-password
MINIO_APP_USER=campus_app
MINIO_APP_PASSWORD=replace-with-a-fourth-random-alphanumeric-password
MINIO_BUCKET=campus-simulation
MINIO_REFERENCE_BUCKET=campus-reference-data
MINIO_CONSOLE_PORT=9001
SIMULATION_WORKER_CONCURRENCY=2

# Adjust these to the public address used for the deployment.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
